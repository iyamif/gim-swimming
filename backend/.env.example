# ==========================================
# EMAIL DELIVERY CONFIGURATION (Reset Password OTP)
# ==========================================

# OPSI 1: RESEND API (Sangat Direkomendasikan - Bebas Blokir ISP / Port Timeout)
# Gratis 3.000 email/bulan, setup 30 detik di https://resend.com
# Menggunakan HTTPS (Port 443) sehingga 100% tidak pernah diblokir provider internet manapun
RESEND_API_KEY=
RESEND_FROM=GIM Swimming <onboarding@resend.dev>

# OPSI 2: BREVO API (Alternatif HTTPS Port 443)
# Gratis 300 email/hari di https://brevo.com
BREVO_API_KEY=
BREVO_FROM=admin@gimswimming.com

# OPSI 3: SMTP Standard (Gmail / Custom SMTP)
# Catatan: Port 465/587 sering diblokir oleh ISP rumahan di Indonesia (i/o timeout).
# Jika terkena i/o timeout pada SMTP, gunakan OPSI 1 (RESEND_API_KEY).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=emailanda@gmail.com
SMTP_PASSWORD=sandiaplikasi16digit
SMTP_FROM=emailanda@gmail.com

